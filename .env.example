# ===========================================================================
# Foolad Tabar Workflow - environment configuration
# Copy this file to ".env" (same folder) and fill in real values.
#   cp .env.example .env
# Docker Compose reads ".env" automatically. Never commit the real .env.
# ===========================================================================

# --- Security ---------------------------------------------------------------
# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_to_a_long_random_string

# Local development: set to 1. Docker Compose sets DJANGO_DEBUG=0.
DJANGO_DEBUG=1

# Hosts/domains that may serve the app. Comma-separated, no spaces.
# Use your server's IP and/or domain. Examples:
#   DJANGO_ALLOWED_HOSTS=203.0.113.10
#   DJANGO_ALLOWED_HOSTS=workflow.example.com,203.0.113.10
# Space-separated hosts (Compose .env truncates commas). Settings also accept commas.
#   DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Only needed if you serve over HTTPS behind a domain. Comma-separated, with
# scheme. Leave blank for plain IP:port access. Example:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://workflow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local time zone used for display.
DJANGO_TIME_ZONE=Asia/Tehran

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_DB=ftworkflow
POSTGRES_USER=ftworkflow
# Pick a strong password. Required.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Web server -------------------------------------------------------------
# Host port the app is published on (browser -> http://SERVER_IP:WEB_PORT).
WEB_PORT=8000
# Number of gunicorn worker processes. ~2x CPU cores is a good start.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- First administrator (optional) -----------------------------------------
# If both username and password are set, this admin is created automatically
# on first start and gains full management access. Leave blank to instead run
# "createsuperuser" yourself after the stack is up.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Workflow policy --------------------------------------------------------
# When 1/true: Technical cannot submit TO to Supply if any row lacks an FTCO
# code. Default is 0/false (codes optional). Set to 1 to enforce codes.
# Other gates (Technical Problem flags, etc.) stay unchanged.
REQUIRE_FTCO_CODE_TO_SUPPLY=0

# --- Cache (optional) --------------------------------------------------
# Leave blank to keep using the existing database-backed cache (default,
# works out of the box). Set this only once the redis service in
# docker-compose.yml is up and healthy — switching it on before that will
# break anything that touches the cache (including the login throttle).
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- Backups ----------------------------------------------------------------
# Host folder (next to the project) has three subfolders: db / media / code_db.
# Nightly PostgreSQL archives to keep under backups/db/ (default 33 days).
BACKUP_DB_KEEP=33
# Media archives under backups/media/ older than this many days are deleted.
BACKUP_MEDIA_KEEP_DAYS=10
# Code SQLite tables: one file under backups/code_db/ refreshed every 3 days.
