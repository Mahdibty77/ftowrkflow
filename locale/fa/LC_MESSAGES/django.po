# ---------------------------------------------------------------------------
# AUDIT #134 FOLLOW-UP (this round) — closing three confirmed i18n gaps where
# sidebar/chrome already translated but a piece of business vocabulary right
# beside it did not:
#
# 1. accounts/constants.py's Unit/Role/SupplyKind/Gender.CHOICES were plain
#    Python strings, never gettext_lazy-wrapped, unlike every choices= list
#    elsewhere in the platform. They feed Profile.unit_label/role_label/
#    title_line ("Marketing · Expert"), rendered on nearly every page — the
#    sidebar footer, People, the Console, a company's sub-header, a case's
#    "holding unit" field. "Commercial"/"Technical"/"Supply"/"Marketing"
#    already had catalog entries (added when marketing/rolechart.py and the
#    company pages were translated) and are reused here rather than
#    duplicated — only Manager/Supervisor/Expert/Internal Supply/External
#    Supply/Male/Female are new entries below.
#
# 2. cases/constants.py::MarketingLabel.CHOICES / MANUAL_ONLY_CHOICES — the
#    role-tag vocabulary on Company Directory chips, Company Detail's role
#    card and the Case-Create marketing-role dropdown — was checked against
#    marketing/rolechart.py's SLOTS (the hand-written "<fa> — <EN>" text the
#    relationship chart uses). They already matched byte-for-byte, key for
#    key, with no drift: no code change was needed for this one and no new
#    catalog entries were required. Recorded here for the audit trail; see
#    the round's own final report for the verification that produced this
#    finding.
#
# 3. cases/constants.py::CaseStatus.ARCHIVE_GROUP / ARCHIVE_TAB_ORDER are
#    documented, on purpose, as internal Python/JS matching keys that must
#    stay plain English (cases/services.py::archive_tab_counts matches a
#    row's own status_fval against them, and archive.html's data-status /
#    the hidden fstatus control post them straight back). The archive page's
#    own status-TAB-STRIP text was the one place still reading those raw
#    English keys as its visible label, while the per-row status column two
#    inches below it already read translated text from CaseStatus.LABELS.
#    Fixed with a SEPARATE display-only dict, ARCHIVE_GROUP_LABELS, used only
#    by archive_tab_counts() to build each tab's visible words/tooltip —
#    ARCHIVE_GROUP/ARCHIVE_TAB_ORDER themselves are untouched. Six of its ten
#    entries (Draft/With Technical/With Supply/Cannot supply/Burned/
#    Cancelled) resolve to already-catalogued CaseStatus.LABELS text with no
#    new msgid; the other four (the tab strip's own shorter phrasings of
#    "With Commercial (final)", "Closed / Sent to client", "Final Approved"
#    and "Final Closed") are new entries below.
# ---------------------------------------------------------------------------

#. accounts/constants.py::Role — the seat role shown in "<Unit> · <Role>"
#. everywhere a person's title line is rendered (sidebar footer, People,
#. Console, company sub-header, case holding-unit field). Role.MANAGER now
#. displays as "Supervisor" (this same msgid, below) and Role.SUPERVISOR now
#. displays as "Observer" — see accounts/constants.py's own "ROLE LABELS VS.
#. ROLE CODES" docstring section. This "Manager" entry is no longer referenced
#. by any CHOICES tuple; left in place rather than deleted, gettext-orphan
#. entries are harmless and a future real makemessages run will prune it.
#: accounts/constants.py:76
msgid "Manager"
msgstr "مدیر"

#. accounts/constants.py::Role.MANAGER's own label as of the rename above.
#: accounts/constants.py:76
msgid "Supervisor"
msgstr "سرپرست"

#: accounts/constants.py:78
msgid "Expert"
msgstr "کارشناس"

#. accounts/constants.py::Role.SUPERVISOR's own label as of the rename above
#. — freed up "Supervisor" (now Role.MANAGER's) for exactly this reason.
#: accounts/constants.py:77
msgid "Observer"
msgstr "ناظر"

#. accounts/constants.py::SupplyKind — Internal vs External split shown only
#. for Supply experts, alongside their unit/role title line.
#: accounts/constants.py:78
msgid "Internal Supply"
msgstr "تأمین داخلی"

#: accounts/constants.py:79
msgid "External Supply"
msgstr "تأمین خارجی"

#. accounts/constants.py::Gender — chooses the Mr./Ms. honorific on exported
#. documents (accounts.models.Profile.honorific_last_name); the CHOICES text
#. itself (this entry) is the plain "Male"/"Female" shown in the account's
#. own edit form, never on an exported document — see Gender.HONORIFIC's own
#. comment for why that dict stays plain "Mr."/"Ms." regardless of language.
#: accounts/constants.py:92
msgid "Male"
msgstr "مرد"

#: accounts/constants.py:93
msgid "Female"
msgstr "زن"

#. cases/constants.py::CaseStatus.ARCHIVE_GROUP_LABELS — display-only text
#. for the Case Archive page's status tab strip (cases/templates/cases/
#. archive.html). "With Commercial" collapses three statuses (Returned to
#. Commercial, Pending cancel, With Commercial (final)) into one tab; the
#. Persian below deliberately drops the "(نهایی)" suffix the single-status
#. "With Commercial (final)" label carries, since this tab covers all three.
#: cases/constants.py:377
msgid "With Commercial"
msgstr "نزد بازرگانی"

#. Shorter tab-strip phrasing of "Closed / Sent to client" (cases/
#. constants.py's own CaseStatus.CHOICES entry for CLOSED).
#: cases/constants.py:378
msgid "Sent to client"
msgstr "ارسال‌شده به مشتری"

#. Same word as "Final Approved" (cases/constants.py's CaseStatus.CHOICES),
#. lower-cased for the tab strip's own sentence-case style; same Persian.
#: cases/constants.py:379
msgid "Final approved"
msgstr "تأیید نهایی"

#. Same word as "Final Closed" (cases/constants.py's CaseStatus.CHOICES),
#. lower-cased for the tab strip's own sentence-case style; same Persian.
#: cases/constants.py:380
msgid "Final closed"
msgstr "بسته نهایی"

# ---------------------------------------------------------------------------
# AUDIT #134 FOLLOW-UP (this round) — two mechanisms the app's own bilingual
# chrome never reached:
#
# 1. DJANGO FLASH/TOAST MESSAGES. Every literal string argument to
#    messages.success()/error()/warning()/info() across accounts/views.py,
#    people/views.py, people/views_requests.py, cases/views.py,
#    itemcoder/bridge.py, itemcoder/data_admin.py and itemcoder/tool_access.py
#    is now wrapped in gettext() (not gettext_lazy — these are evaluated
#    per-request, at call time, same as cases/views.py's pre-existing
#    pi_locked_reason/to_locked_reason messages). A message that interpolates
#    real business data (a person's name, a seat/role/client code, a document
#    number, an exception's own text) keeps that value OUTSIDE the translated
#    text via a %(name)s-style placeholder — only the surrounding English
#    sentence is a catalog entry, never the interpolated value itself. A few
#    call sites turned out to already be covered by earlier-round entries
#    ("No personnel record is linked to this login.", the pi_locked_reason/
#    to_locked_reason pair, and "Technical Offer"/"Proforma" themselves) and
#    are reused rather than duplicated — not listed again below. Deliberately
#    left OUT OF SCOPE: messages.*() calls whose argument is already a
#    variable rather than a literal (str(exc), a service-returned refusal/
#    warning string, Django form.add_error() text) — translating those means
#    reaching into cases.inquiry_validate / people.seats / cases.services and
#    similar shared validators, a separate, larger change; the two
#    session-flash dicts (_reveal_credential, _seat_row_flash) accounts/
#    views.py writes outside the messages framework entirely; and the
#    'title'/'hint' upload-page context strings in cases/views.py, which are
#    plain template context, not flash messages.
#
# 2. marketing/static/marketing/js/chart_interact.js — the relationship-chart
#    page's interactive JS hard-coded English UI text set via .textContent/
#    .innerHTML/.placeholder/aria-label, invisible to Django's own {% trans %}
#    and unreachable by the language toggle. Fixed the same way home.html's
#    {% block scripts %} already bridges template -> JS for this chart: every
#    string below is rendered server-side via {% trans %} into
#    window.FT_MARKETING_CHART.i18n, and chart_interact.js reads from that
#    object (via the new t()/fmt() helpers at its own top) instead of a
#    literal at each of the spots the review flagged — updateModeBanner()'s
#    full set of mode-banner states, including the composite "edits attach
#    to …"/"chart is showing …" sentences (each carrying a SEPARATE
#    fully-translated with-role/without-role template rather than one
#    template with a spliced-in fragment, so Persian word order is free to
#    differ from English in either shape), quickResetRoleField('Pick a
#    company first…')'s page-init call (which was overwriting home.html's
#    own {% trans %} placeholder the instant the page loaded — the worst of
#    the group, per the review), the company/role/case picker empty-states,
#    the "us" card's heading/count line/archive link, the "+ Add company"
#    panel, the "No … yet" empty-state variants, and the tooltip/aria-label
#    pair. A few keys (Active/Deactivate/Add/"Pick a company first…"/"Choose
#    a role to add…") deliberately reuse a msgid this same page already
#    carries as static chrome rather than duplicating it — not listed again
#    below. No business logic, branching or DOM structure in that file was
#    touched — every change is a string-source swap at the exact spot the
#    string was already being set.
# ---------------------------------------------------------------------------

#: accounts/views.py:1169
msgid "You're back in your own account."
msgstr "شما به حساب کاربری خودتان بازگشتید."

#: accounts/views.py:445
msgid "Administrator and General Manager seats are not assigned this way."
